{
  "name": "jw-app", "private": true, "version": "0.1.0", "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "node scripts/dev.mjs", "dev:web": "npm run dev --workspace @jw-app/web", "dev:server": "npm run dev --workspace @jw-app/server",
    "typecheck": "npm run typecheck --workspaces --if-present", "build": "npm run build --workspace @jw-app/shared && npm run build --workspace @jw-app/server && npm run build --workspace @jw-app/web",
    "preview": "npm run preview --workspace @jw-app/web", "start:server": "npm run start --workspace @jw-app/server"
  },
  "devDependencies": { "typescript": "~5.9.3", "@types/node": "^24.0.0" }
}
